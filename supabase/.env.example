# Copy to supabase/.env (gitignored) and fill in. Never commit the real file.

# GitHub App (Settings → Developer settings → GitHub Apps → your app)
GITHUB_APP_ID=
# The app's private key (.pem), base64-encoded on one line: base64 -w0 your-app.private-key.pem
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_WEBHOOK_SECRET=

# Claude
ANTHROPIC_API_KEY=
# Optional, default claude-opus-5-5. claude-haiku-5-5 is much cheaper.
KRILL_MODEL=

# Optional. Without it, reviews skip the code index (helper catalog and similar-code search)
# and all rules are sent to the model without vector search.
VOYAGE_API_KEY=
